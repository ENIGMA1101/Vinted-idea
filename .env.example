# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Railway, Neon, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/reseller_dashboard"

# ── App Auth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Token Encryption ───────────────────────────────────────
# 32-byte hex key for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# ── eBay Developer App (Sandbox) ───────────────────────────
# Register at https://developer.ebay.com → My Account → Application Keys
# Use Sandbox keys for development
EBAY_CLIENT_ID="your-ebay-sandbox-client-id"
EBAY_CLIENT_SECRET="your-ebay-sandbox-client-secret"
# Must match exactly what you set in eBay developer portal under User Tokens → RuName
EBAY_REDIRECT_URI="http://localhost:3000/api/ebay/callback"
# Set to "true" for sandbox, "false" for production
EBAY_SANDBOX="true"
# Your eBay RuName (from developer portal → User Tokens)
EBAY_RUNAME="your-ebay-runame-here"

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs from your Stripe dashboard (monthly)
STRIPE_PRICE_STARTER="price_starter_monthly"
STRIPE_PRICE_PRO="price_pro_monthly"
STRIPE_PRICE_BUSINESS="price_business_monthly"

# ── App URL ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
